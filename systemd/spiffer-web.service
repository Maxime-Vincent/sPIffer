[Unit]
Description=sPIffer web interface
After=network-online.target spiffer-iface-config.service
Wants=network-online.target
Requires=spiffer-iface-config.service

[Service]
Type=simple
WorkingDirectory=/usr/lib/spiffer

ExecStartPre=/bin/bash -c 'test -r /etc/spiffer/certs/server.key || { echo "Missing TLS private key"; exit 1; }'
ExecStartPre=/bin/bash -c 'test -r /etc/spiffer/certs/server.crt || { echo "Missing TLS certificate"; exit 1; }'

ExecStart=/usr/bin/node /usr/lib/spiffer/src/server.js

Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=SPIFFER_WEB_GROUP=spiffer-web

StateDirectory=spiffer
LogsDirectory=spiffer
RuntimeDirectory=spiffer

AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target