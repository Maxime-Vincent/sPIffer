#!/bin/bash
set -e

case "$1" in
  configure)
    echo "# Creating spiffer system user"
    if ! getent passwd spiffer >/dev/null 2>&1; then
      useradd --system --no-create-home --shell /usr/sbin/nologin spiffer
    fi

    echo "# Generating HTTPS certificate if needed"
    if [ -x /usr/lib/spiffer/scripts/spiffer-generate-cert.sh ]; then
      /usr/lib/spiffer/scripts/spiffer-generate-cert.sh || true
    fi
    ;;
esac

#DEBHELPER#

exit 0